    "/admin/tasks": {
      "get": {
        "tags": ["Admin - Tasks"],
        "summary": "Get All Tasks (Admin)",
        "description": "Admin mendapatkan semua tugas. Bisa difilter berdasarkan status dan technician_id.",
        "operationId": "adminGetTasks",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter berdasarkan status",
            "schema": {
              "type": "string",
              "enum": ["pending", "assigned", "accepted", "on-going", "completed"]
            }
          },
          {
            "name": "technician_id",
            "in": "query",
            "required": false,
            "description": "Filter berdasarkan ID teknisi",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar tugas berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Task" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Admin - Tasks"],
        "summary": "Create Task (Admin)",
        "description": "Admin membuat tugas baru. Jika technician_id diisi, status otomatis 'assigned'. Jika tidak, status 'pending'.",
        "operationId": "adminCreateTask",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "customer_name", "description", "address"],
                "properties": {
                  "title": { "type": "string", "example": "Perbaikan AC Gedung A" },
                  "customer_name": { "type": "string", "example": "PT. ABC" },
                  "description": { "type": "string", "example": "AC di lantai 3 tidak dingin" },
                  "address": { "type": "string", "example": "Jl. Sudirman No. 10, Jakarta" },
                  "latitude": { "type": "number", "format": "float", "nullable": true, "example": -6.2088 },
                  "longitude": { "type": "number", "format": "float", "nullable": true, "example": 106.8456 },
                  "technician_id": { "type": "integer", "nullable": true, "example": 2, "description": "ID teknisi. Jika diisi, status otomatis 'assigned'." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tugas berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Task" }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          }
        }
      }
    },
