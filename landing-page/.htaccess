# ==============================================================================
# BENTENG SIBER — ENTERPRISE SECURITY & CACHE POLICIES
# ==============================================================================

<IfModule mod_headers.c>
    # 1. OWASP RECOMMENDED SECURITY HEADERS
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 2. CACHE-CONTROL & REVALIDATION
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(png|ico|jpg|jpeg|svg|webp|woff2)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
</IfModule>

# 3. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. DEFENSIVE ACCESS CONTROLS
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny access to dotfiles & dotdirectories (.env, .git, etc.) except .well-known
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Block direct HTTP access to laravel-core codebase from root domain
    RewriteRule ^laravel-core/ - [F,L]

    # Block log, sql, pem, and config files
    RewriteRule \.(log|sql|pem|key|crt|ini|bak|env)$ - [F,L]
</IfModule>

# Disable directory browsing
Options -Indexes
